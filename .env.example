# Copy to .env (never commit .env). Every value below works for local development as-is.

# --- Database (MySQL 8) ----------------------------------------------------------
DATABASE_URL=mysql://enroll:enroll_pw@127.0.0.1:3307/enrollment_dev
# Hosted databases need TLS. Keep certificate checking on; if the provider uses its own CA
# (Aiven does), paste the CA certificate as ONE line with literal \n between lines.
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
# Connections per server instance (clamped 1 to 5). Keep it small on serverless.
DB_POOL_LIMIT=5

# --- Auth ----------------------------------------------------------------------------
# At least 32 random characters in production, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-dev-only-change-me-dev-only
# true in production (HTTPS only). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Only needed if the browser talks to the API on a DIFFERENT origin (it normally does not: see README).
CLIENT_ORIGIN=

# --- Demo features -----------------------------------------------------------------------
# One-click demo logins and the Rush Simulator. Every demo account shares a known password,
# so turn this OFF for anything that is not a classroom demo with fake data.
DEMO_MODE=true
# four-point (0.0 to 4.0, higher is better) or five-point (1.0 to 5.0, lower is better)
GRADING_POLICY=four-point

NODE_ENV=development
PORT=4000

# --- Tests ---------------------------------------------------------------------------------
# The test suites TRUNCATE tables, so they only run against a database whose name ends in _test.
TEST_DATABASE_URL=mysql://enroll:enroll_pw@127.0.0.1:3307/enrollment_test
